{
  "schema_version": 1,
  "description": "Shared catalog of AI wire protocols. Every traceAI SDK loads a byte-identical copy of this file to recognize AI API calls at the HTTP layer. Patterns use the portable regex subset accepted by Python re, JavaScript RegExp, Go RE2, .NET and Java: no lookaround, no backreferences, named groups written as (?<name>...).",
  "default_provider": "openai_compatible",
  "providers": [
    {"name": "openai", "hosts": ["api.openai.com"]},
    {"name": "azure.ai.openai", "host_suffixes": [".openai.azure.com", ".cognitiveservices.azure.com", ".services.ai.azure.com"]},
    {"name": "anthropic", "hosts": ["api.anthropic.com"]},
    {"name": "gcp.gemini", "hosts": ["generativelanguage.googleapis.com"]},
    {"name": "gcp.vertex_ai", "hosts": ["aiplatform.googleapis.com"], "host_suffixes": ["-aiplatform.googleapis.com"]},
    {"name": "aws.bedrock", "host_prefixes": ["bedrock-runtime."], "host_suffixes": [".amazonaws.com"], "match": "all"},
    {"name": "mistral_ai", "hosts": ["api.mistral.ai", "codestral.mistral.ai"]},
    {"name": "groq", "hosts": ["api.groq.com"]},
    {"name": "together", "hosts": ["api.together.xyz", "api.together.ai"]},
    {"name": "fireworks", "hosts": ["api.fireworks.ai"]},
    {"name": "deepseek", "hosts": ["api.deepseek.com"]},
    {"name": "x_ai", "hosts": ["api.x.ai"]},
    {"name": "cerebras", "hosts": ["api.cerebras.ai"]},
    {"name": "openrouter", "hosts": ["openrouter.ai"]},
    {"name": "perplexity", "hosts": ["api.perplexity.ai"]},
    {"name": "cohere", "hosts": ["api.cohere.com", "api.cohere.ai"]},
    {"name": "voyage", "hosts": ["api.voyageai.com"]},
    {"name": "jina", "hosts": ["api.jina.ai"]},
    {"name": "huggingface", "hosts": ["router.huggingface.co", "api-inference.huggingface.co"], "host_suffixes": [".endpoints.huggingface.cloud"]},
    {"name": "deepinfra", "hosts": ["api.deepinfra.com"]},
    {"name": "sambanova", "hosts": ["api.sambanova.ai"]},
    {"name": "hyperbolic", "hosts": ["api.hyperbolic.xyz"]},
    {"name": "novita", "hosts": ["api.novita.ai"]},
    {"name": "nebius", "hosts": ["api.studio.nebius.com", "api.studio.nebius.ai", "api.tokenfactory.nebius.com"]},
    {"name": "nvidia_nim", "hosts": ["integrate.api.nvidia.com"]},
    {"name": "baseten", "hosts": ["inference.baseten.co"], "host_suffixes": [".api.baseten.co"]},
    {"name": "lambda", "hosts": ["api.lambda.ai", "api.lambdalabs.com"]},
    {"name": "moonshot", "hosts": ["api.moonshot.ai", "api.moonshot.cn"]},
    {"name": "alibaba.dashscope", "hosts": ["dashscope.aliyuncs.com", "dashscope-intl.aliyuncs.com"]},
    {"name": "zhipu", "hosts": ["open.bigmodel.cn", "api.z.ai"]},
    {"name": "minimax", "hosts": ["api.minimax.io", "api.minimaxi.com", "api.minimax.chat"]},
    {"name": "ai21", "hosts": ["api.ai21.com"]},
    {"name": "portkey", "hosts": ["api.portkey.ai"]},
    {"name": "cloudflare.workers_ai", "hosts": ["api.cloudflare.com"], "host_suffixes": [".gateway.ai.cloudflare.com"]},
    {"name": "github_models", "hosts": ["models.github.ai", "models.inference.ai.azure.com"]},
    {"name": "ollama", "ports": [11434], "hosts": ["ollama.com"]},
    {"name": "deepgram", "hosts": ["api.deepgram.com", "api.eu.deepgram.com"]},
    {"name": "elevenlabs", "hosts": ["api.elevenlabs.io", "api.us.elevenlabs.io", "api.eu.residency.elevenlabs.io"]},
    {"name": "assemblyai", "hosts": ["api.assemblyai.com", "api.eu.assemblyai.com"]},
    {"name": "cartesia", "hosts": ["api.cartesia.ai"]},
    {"name": "replicate", "hosts": ["api.replicate.com"]}
  ],
  "endpoints": [
    {"id": "openai.chat_completions", "methods": ["POST"], "path": "(?:^|/)chat/completions$", "format": "openai.chat", "operation": "chat", "span_kind": "LLM"},
    {"id": "mistral.fim_completions", "methods": ["POST"], "path": "(?:^|/)fim/completions$", "format": "openai.chat", "operation": "text_completion", "span_kind": "LLM"},
    {"id": "openai.completions", "methods": ["POST"], "path": "(?:^|/)completions$", "format": "openai.completions", "operation": "text_completion", "span_kind": "LLM"},
    {"id": "openai.responses", "methods": ["POST"], "path": "(?:^|/)responses$", "format": "openai.responses", "operation": "chat", "span_kind": "LLM"},
    {"id": "openai.embeddings", "methods": ["POST"], "path": "(?:^|/)embeddings$", "format": "openai.embeddings", "operation": "embeddings", "span_kind": "EMBEDDING", "exclude_providers": ["ollama"]},
    {"id": "openai.audio_transcriptions", "methods": ["POST"], "path": "(?:^|/)audio/transcriptions$", "format": "openai.audio_transcription", "operation": "transcription", "span_kind": "LLM"},
    {"id": "openai.audio_translations", "methods": ["POST"], "path": "(?:^|/)audio/translations$", "format": "openai.audio_transcription", "operation": "translation", "span_kind": "LLM"},
    {"id": "openai.audio_speech", "methods": ["POST"], "path": "(?:^|/)audio/speech$", "format": "openai.audio_speech", "operation": "text_to_speech", "span_kind": "LLM"},
    {"id": "openai.images_generations", "methods": ["POST"], "path": "(?:^|/)images/generations$", "format": "openai.images", "operation": "image_generation", "span_kind": "LLM"},
    {"id": "openai.moderations", "methods": ["POST"], "path": "(?:^|/)moderations$", "format": "openai.moderations", "operation": "moderation", "span_kind": "GUARDRAIL"},
    {"id": "rerank", "methods": ["POST"], "path": "(?:^|/)rerank$", "format": "rerank", "operation": "rerank", "span_kind": "RERANKER", "default_provider": "cohere_compatible"},
    {"id": "anthropic.messages", "methods": ["POST"], "path": "(?:^|/)v1/messages$", "format": "anthropic.messages", "operation": "chat", "span_kind": "LLM", "default_provider": "anthropic_compatible"},
    {"id": "vertex.anthropic_raw_predict", "methods": ["POST"], "path": "/publishers/anthropic/models/(?<model>[^/:]+):(?:streamRawPredict|rawPredict)$", "format": "anthropic.messages", "operation": "chat", "span_kind": "LLM"},
    {"id": "gemini.generate_content", "methods": ["POST"], "path": "/models/(?<model>[^/:]+):(?:generateContent|streamGenerateContent)$", "format": "gemini.generate_content", "operation": "generate_content", "span_kind": "LLM", "default_provider": "gemini_compatible"},
    {"id": "gemini.embed_content", "methods": ["POST"], "path": "/models/(?<model>[^/:]+):(?:embedContent|batchEmbedContents)$", "format": "gemini.embed_content", "operation": "embeddings", "span_kind": "EMBEDDING", "default_provider": "gemini_compatible"},
    {"id": "cohere.chat", "methods": ["POST"], "path": "^/v[12]/chat$", "format": "cohere.chat", "operation": "chat", "span_kind": "LLM", "providers": ["cohere"]},
    {"id": "cohere.embed", "methods": ["POST"], "path": "^/v[12]/embed$", "format": "cohere.embed", "operation": "embeddings", "span_kind": "EMBEDDING", "providers": ["cohere"]},
    {"id": "bedrock.converse", "methods": ["POST"], "path": "^/model/(?<model>[^/]+)/(?:converse|converse-stream)$", "format": "bedrock.converse", "operation": "chat", "span_kind": "LLM", "providers": ["aws.bedrock"]},
    {"id": "bedrock.invoke_model", "methods": ["POST"], "path": "^/model/(?<model>[^/]+)/(?:invoke|invoke-with-response-stream)$", "format": "bedrock.invoke", "operation": "chat", "span_kind": "LLM", "providers": ["aws.bedrock"]},
    {"id": "ollama.chat", "methods": ["POST"], "path": "^/api/chat$", "format": "ollama.chat", "operation": "chat", "span_kind": "LLM", "providers": ["ollama"]},
    {"id": "ollama.generate", "methods": ["POST"], "path": "^/api/generate$", "format": "ollama.generate", "operation": "text_completion", "span_kind": "LLM", "providers": ["ollama"]},
    {"id": "ollama.embed", "methods": ["POST"], "path": "^/api/embed(?:dings)?$", "format": "ollama.embed", "operation": "embeddings", "span_kind": "EMBEDDING", "providers": ["ollama"]},
    {"id": "deepgram.listen", "methods": ["POST"], "path": "^/v1/listen$", "format": "deepgram.listen", "operation": "transcription", "span_kind": "LLM", "providers": ["deepgram"]},
    {"id": "deepgram.speak", "methods": ["POST"], "path": "^/v1/speak$", "format": "deepgram.speak", "operation": "text_to_speech", "span_kind": "LLM", "providers": ["deepgram"]},
    {"id": "elevenlabs.text_to_speech", "methods": ["POST"], "path": "^/v1/text-to-speech/(?<voice>[^/]+)(?:/stream)?(?:/with-timestamps)?$", "format": "elevenlabs.tts", "operation": "text_to_speech", "span_kind": "LLM", "providers": ["elevenlabs"]},
    {"id": "elevenlabs.speech_to_text", "methods": ["POST"], "path": "^/v1/speech-to-text$", "format": "elevenlabs.stt", "operation": "transcription", "span_kind": "LLM", "providers": ["elevenlabs"]},
    {"id": "assemblyai.transcript_submit", "methods": ["POST"], "path": "^/v2/transcript$", "format": "assemblyai.transcript", "operation": "transcription", "span_kind": "LLM", "providers": ["assemblyai"]},
    {"id": "assemblyai.transcript_result", "methods": ["GET"], "path": "^/v2/transcript/(?<transcript_id>[A-Za-z0-9_-]+)$", "format": "assemblyai.transcript", "operation": "transcription", "span_kind": "LLM", "providers": ["assemblyai"], "only_when": "completed"},
    {"id": "cartesia.tts", "methods": ["POST"], "path": "^/tts/(?:bytes|sse)$", "format": "cartesia.tts", "operation": "text_to_speech", "span_kind": "LLM", "providers": ["cartesia"]}
  ]
}
