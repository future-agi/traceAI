{
  "name": "cohere-v2-chat-stream",
  "request": {
    "method": "POST",
    "url": "https://api.cohere.com/v2/chat",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "command-a-03-2025",
      "stream": true,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "event": "message-start",
        "type": "message-start",
        "id": "co-s",
        "delta": {
          "message": {
            "role": "assistant"
          }
        }
      },
      {
        "event": "content-delta",
        "type": "content-delta",
        "index": 0,
        "delta": {
          "message": {
            "content": {
              "text": "Hel"
            }
          }
        }
      },
      {
        "event": "content-delta",
        "type": "content-delta",
        "index": 0,
        "delta": {
          "message": {
            "content": {
              "text": "lo"
            }
          }
        }
      },
      {
        "event": "message-end",
        "type": "message-end",
        "delta": {
          "finish_reason": "COMPLETE",
          "usage": {
            "tokens": {
              "input_tokens": 3,
              "output_tokens": 2
            }
          }
        }
      }
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat command-a-03-2025",
    "status": "OK",
    "attributes": {
      "output.value": "Hello",
      "gen_ai.response.id": "co-s",
      "gen_ai.response.finish_reasons": [
        "COMPLETE"
      ],
      "gen_ai.usage.input_tokens": 3,
      "gen_ai.usage.output_tokens": 2,
      "gen_ai.request.stream": true
    }
  }
}
