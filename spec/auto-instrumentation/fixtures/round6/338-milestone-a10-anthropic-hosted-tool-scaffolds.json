{
  "name": "milestone-a10-anthropic-hosted-tool-scaffolds",
  "description": "Type/ID/language metadata, empty content lists, citations, stop events and tool results are not model-output deltas.",
  "request": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "claude-fixture",
      "max_tokens": 100,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
