      },
      {
        "type": "content_block_start",
        "content_block": {
          "type": "mcp_tool_use",
          "id": "mcp-r6b",
          "name": null,
          "input": {}
        }
      },
      {
        "type": "content_block_start",
        "content_block": {
          "type": "web_search_tool_result",
          "content": [
            {
              "title": "result"
            }
          ]
        }
      },
      {
        "type": "content_block_start",
        "content_block": {
          "type": "mcp_tool_result",
          "content": "tool result"
        }
      },
      {
        "type": "content_block_stop",
        "index": 0
      }
