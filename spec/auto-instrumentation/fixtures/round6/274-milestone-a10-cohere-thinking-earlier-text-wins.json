{
  "name": "milestone-a10-cohere-thinking-earlier-text-wins",
  "description": "Earlier ordinary text at 30ms wins over thinking/tool/code output at 70ms.",
  "request": {
    "method": "POST",
    "url": "https://api.cohere.com/v2/chat",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "fixture-model",
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "type": "message-start",
        "delta": {
          "message": {
            "role": "assistant"
          }
        }
      },
      {
        "type": "content-delta",
        "delta": {
          "message": {
            "content": {
              "text": "Later"
            }
          }
        }
      },
      {
        "type": "content-delta",
        "delta": {
          "message": {
            "content": {
              "thinking": "Thinking"
            }
          }
        }
      },
      {
        "type": "message-end"
      }
    ],
    "arrival_offsets_ms": [
      10,
      30,
      70,
      90
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat fixture-model",
    "status": "OK",
    "attributes": {
      "gen_ai.response.time_to_first_chunk": 0.01,
      "gen_ai.response.time_to_first_text": 0.03,
      "gen_ai.request.stream": true
    },
    "absent": []
  }
}
