    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "fixture-model",
      "input": "Hi"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "id": "resp_1",
      "object": "response",
      "model": "gpt-5-2025-08-07",
      "status": "completed",
      "output": [
        {
          "type": "reasoning",
          "summary": []
        },
        {
          "type": "message",
