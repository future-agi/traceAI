{
  "name": "milestone-a10-anthropic-thinking-positive",
  "description": "Only the nonempty output at 30ms qualifies; later ordinary text at 70ms cannot replace it.",
  "request": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "claude-fixture",
      "max_tokens": 100,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "type": "message_start",
        "message": {
          "role": "assistant",
          "content": []
        }
      },
      {
        "type": "content_block_delta",
        "index": 0,
        "delta": {
          "type": "thinking_delta",
          "thinking": ""
        }
      },
      {
        "type": "content_block_delta",
        "index": 0,
        "delta": {
          "type": "thinking_delta",
          "thinking": "Thinking"
        }
      },
      {
        "type": "content_block_delta",
        "index": 0,
        "delta": {
