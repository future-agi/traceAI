{
  "name": "anthropic-stream-cache-ttl-snapshots",
  "description": "Merge cumulative snapshots first; 30+100+20=150, not 170 from adding TTL partitions or repeated snapshots.",
  "request": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "claude-fixture",
      "max_tokens": 100,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "event": "message_start",
        "type": "message_start",
        "message": {
          "id": "msg-r6",
          "model": "claude-fixture",
          "role": "assistant",
          "content": [],
          "usage": {
            "input_tokens": 30,
            "output_tokens": 1,
            "cache_read_input_tokens": 100,
            "cache_creation_input_tokens": 20,
            "cache_creation": {
              "ephemeral_5m_input_tokens": 5,
              "ephemeral_1h_input_tokens": 15
            }
          }
        }
      },
      {
        "event": "content_block_start",
        "type": "content_block_start",
        "index": 0,
        "content_block": {
          "type": "text",
          "text": ""
        }
      },
      {
        "event": "content_block_delta",
        "type": "content_block_delta",
        "index": 0,
        "delta": {
          "type": "text_delta",
          "text": "Hi"
        }
      },
      {
        "event": "message_delta",
        "type": "message_delta",
        "usage": {
          "output_tokens": 10
        }
      },
      {
        "event": "message_delta",
        "type": "message_delta",
        "usage": {
          "output_tokens": 10
        }
      },
      {
        "event": "message_delta",
        "type": "message_delta",
        "delta": {
          "stop_reason": "end_turn"
        },
        "usage": {
          "output_tokens": 25,
          "cache_creation": {
            "ephemeral_5m_input_tokens": 5
          }
        }
      },
      {
        "event": "message_stop",
        "type": "message_stop"
      }
    ],
    "arrival_offsets_ms": [
      10,
      20,
      40,
      70,
      100,
      130,
      150
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat claude-fixture",
    "status": "OK",
    "attributes": {
      "gen_ai.response.time_to_first_chunk": 0.01,
      "gen_ai.response.time_to_first_text": 0.04,
      "output.value": "Hi",
      "gen_ai.request.stream": true,
      "gen_ai.usage.input_tokens": 150,
      "gen_ai.usage.output_tokens": 25,
      "gen_ai.usage.total_tokens": 175,
      "gen_ai.usage.cache_read_tokens": 100,
      "gen_ai.usage.cache_write_tokens": 20
    },
    "absent": [
      "gen_ai.usage.output_tokens.reasoning",
      "gen_ai.usage.provider_total_tokens"
    ]
  }
}
