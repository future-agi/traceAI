{
  "name": "milestone-a10-anthropic-text-empty",
  "description": "Empty/null payloads and role/ID/finish scaffolds never establish first output.",
  "request": {
    "method": "POST",
    "url": "https://api.anthropic.com/v1/messages",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "claude-fixture",
      "max_tokens": 100,
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "type": "message_start",
        "message": {
          "role": "assistant",
          "content": []
        }
      },
      {
        "type": "content_block_delta",
        "index": 0,
        "delta": {
          "type": "text_delta",
          "text": ""
        }
      },
      {
        "type": "content_block_delta",
        "index": 0,
        "delta": {
          "type": "text_delta",
          "text": null
        }
      },
      {
        "type": "message_stop"
      }
    ],
    "arrival_offsets_ms": [
      10,
      20,
      30,
      70
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat claude-fixture",
    "status": "OK",
    "attributes": {
      "gen_ai.response.time_to_first_chunk": 0.01,
      "gen_ai.request.stream": true
    },
    "absent": [
      "gen_ai.response.time_to_first_text"
    ]
  }
}
