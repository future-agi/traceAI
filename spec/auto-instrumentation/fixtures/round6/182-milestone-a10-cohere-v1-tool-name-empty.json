{
  "name": "milestone-a10-cohere-v1-tool-name-empty",
  "description": "Empty/null payloads and role/ID/finish scaffolds never establish first output.",
  "request": {
    "method": "POST",
    "url": "https://api.cohere.com/v1/chat",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "fixture-model",
      "message": "Hi",
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/x-ndjson"
    },
    "ndjson": [
      {
        "event_type": "stream-start",
        "generation_id": "co-r6b"
      },
      {
        "event_type": "tool-calls-generation",
        "tool_calls": [
          {
            "name": ""
          }
        ]
      },
      {
        "event_type": "tool-calls-generation",
        "tool_calls": [
          {
            "name": null
          }
        ]
      },
      {
        "event_type": "stream-end"
      }
    ],
    "arrival_offsets_ms": [
      10,
      20,
      30,
      70
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat fixture-model",
    "status": "OK",
    "attributes": {
      "gen_ai.response.time_to_first_chunk": 0.01,
      "gen_ai.request.stream": true
    },
    "absent": [
      "gen_ai.response.time_to_first_text"
    ]
  }
}
