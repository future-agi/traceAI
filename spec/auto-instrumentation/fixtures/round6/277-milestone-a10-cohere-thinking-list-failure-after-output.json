{
  "name": "milestone-a10-cohere-thinking-list-failure-after-output",
  "description": "The observed thinking/tool/code milestone survives failure before ordinary text or tool completion.",
  "request": {
    "method": "POST",
    "url": "https://api.cohere.com/v2/chat",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "fixture-model",
      "messages": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "type": "message-start",
        "delta": {
          "message": {
            "role": "assistant"
          }
        }
      },
      {
        "type": "content-delta",
        "delta": {
          "message": {
            "content": [
              {
                "thinking": ""
              }
            ]
          }
        }
      },
      {
        "type": "content-delta",
        "delta": {
          "message": {
            "content": [
              {
                "thinking": "Thinking"
              }
            ]
          }
        }
      },
      {
        "type": "content-delta",
        "delta": {
          "message": {
            "content": {
              "text": "Later"
            }
          }
        }
      }
    ],
    "arrival_offsets_ms": [
      10,
      20,
      30,
      70
    ],
    "error_after_chunks": 3
  },
  "expect": {
    "captured": true,
    "name": "chat fixture-model",
    "status": "ERROR",
    "attributes": {
      "gen_ai.response.time_to_first_chunk": 0.01,
      "gen_ai.response.time_to_first_text": 0.03,
      "gen_ai.request.stream": true
    },
    "absent": []
  }
}
