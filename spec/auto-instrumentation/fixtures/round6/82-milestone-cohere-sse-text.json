        "index": 0,
        "delta": {
          "message": {
            "content": {
              "text": "Hi"
            }
          }
        }
      }
    ],
    "arrival_offsets_ms": [
      10,
      20,
      30
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat fixture-model",
    "status": "OK",
    "attributes": {
