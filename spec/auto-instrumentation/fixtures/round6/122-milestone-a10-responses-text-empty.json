{
  "name": "milestone-a10-responses-text-empty",
  "description": "Empty/null payloads and role/ID/finish scaffolds never establish first output.",
  "request": {
    "method": "POST",
    "url": "https://api.openai.com/v1/responses",
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "model": "fixture-model",
      "input": "Hi",
      "stream": true
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "text/event-stream"
    },
    "sse": [
      {
        "type": "response.created",
        "response": {
          "output": []
        }
      },
      {
        "type": "response.output_text.delta",
        "delta": ""
      },
      {
        "type": "response.output_text.delta",
        "delta": null
      },
      {
        "type": "response.completed",
        "response": {
          "output": []
        }
      }
    ],
    "arrival_offsets_ms": [
      10,
      20,
      30,
      70
    ]
  },
  "expect": {
    "captured": true,
    "name": "chat fixture-model",
    "status": "OK",
    "attributes": {
      "gen_ai.response.time_to_first_chunk": 0.01,
      "gen_ai.request.stream": true
    },
    "absent": [
      "gen_ai.response.time_to_first_text"
    ]
  }
}
