            <groupId>io.opentelemetry</groupId><artifactId>opentelemetry-sdk-testing</artifactId><scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.proto</groupId><artifactId>opentelemetry-proto</artifactId>
