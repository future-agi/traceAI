<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <ProjectReference Include="../../src/TraceAI.AutoInstrumentation/TraceAI.AutoInstrumentation.csproj" />
    <ProjectReference Include="../TraceAI.AutoInstrumentation.TestApp/TraceAI.AutoInstrumentation.TestApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TraceAI.AutoInstrumentation.TestApp/Stock/TraceAI.AutoInstrumentation.StockApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The test runner is net10, so the references above build the child apps for net10.0 only.
       Build their net8.0 targets too. The hook has a single net8.0 target, built by its reference.
       No extra global properties: the solution build then reuses these same builds. -->
  <Target Name="BuildNet8HookTests" BeforeTargets="Build">
    <MSBuild Projects="../TraceAI.AutoInstrumentation.TestApp/TraceAI.AutoInstrumentation.TestApp.csproj;../TraceAI.AutoInstrumentation.TestApp/Stock/TraceAI.AutoInstrumentation.StockApp.csproj"
             Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net8.0" BuildInParallel="false" />
  </Target>
</Project>
