<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- An ASP.NET Core host with DI-registered AI services and no tracing code of its own, run under the
       startup hook by the tests. Microsoft.Extensions.AI 11 targets net10.0 and later. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
  </ItemGroup>
</Project>
