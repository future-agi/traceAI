{
  "name": "@traceai/mistral",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for Mistral AI",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "esnext": "./dist/esnext/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "jest --runInBand && pnpm run test:native",
    "test:native": "node --test test/*.test.cjs",
    "test:types": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck test/types.mts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand && node --test --experimental-test-coverage test/*.test.cjs",
    "lint": "eslint . --ext .ts",
    "prepare": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_mistral"
  },
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  },
  "homepage": "https://docs.futureagi.com/docs/integrations/traceai/mistralai",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.202.0",
    "@opentelemetry/core": "^2.0.1",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "peerDependencies": {
    "@mistralai/mistralai": ">=0.1.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.202.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "@mistralai/mistralai": "^1.0.0",
    "mistral-floor": "npm:@mistralai/mistralai@0.1.3",
    "mistral-v1": "npm:@mistralai/mistralai@1.0.0",
    "mistral-current": "npm:@mistralai/mistralai@3.4.0",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16"
  },
  "keywords": [
    "opentelemetry",
    "instrumentation",
    "typescript",
    "mistral",
    "mistralai",
    "llm",
    "tracing",
    "traceai",
    "futureagi",
    "observability"
  ],
  "author": "Future AGI",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
