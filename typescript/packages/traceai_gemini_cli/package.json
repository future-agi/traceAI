{
  "name": "@traceai/gemini-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Daemon-free Gemini CLI hooks for Future AGI turn tracing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/hook.ts --bundle --platform=node --target=node22 --format=cjs --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --outfile=dist/hook.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@traceai/agent-core": "workspace:^",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.29",
    "esbuild": "0.25.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_gemini_cli"
  },
  "license": "Apache-2.0",
  "author": "Future AGI",
  "publishConfig": {
    "access": "public"
  }
}
