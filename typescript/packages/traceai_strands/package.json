{
  "name": "@traceai/strands",
  "version": "0.1.1",
  "description": "OpenTelemetry instrumentation for AWS Strands Agents SDK",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./native": {
      "types": "./dist/src/native.d.ts",
      "import": "./dist/src/native.js",
      "require": "./dist/src/native.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "jest",
    "prepare": "pnpm run build",
    "test:native": "node --test test/native.test.mjs"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "instrumentation",
    "strands",
    "aws",
    "bedrock",
    "agents",
    "llm",
    "observability",
    "traceai",
    "futureagi"
  ],
  "author": "Future AGI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_strands"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.202.0",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@strands-agents/sdk": "^0.1.0 || ^1.23.0"
  },
  "peerDependenciesMeta": {
    "@strands-agents/sdk": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.futureagi.com/docs/tracing",
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  }
}
