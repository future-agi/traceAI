{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "work_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "format": "uuid"
    },
    "work_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
