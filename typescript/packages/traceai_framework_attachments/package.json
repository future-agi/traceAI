{
  "name": "@traceai/framework-attachments",
  "version": "0.1.0",
  "description": "Typed framework media adapters for the shared traceAI attachment manager",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "esnext": "./dist/esnext/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "node --test test/*.test.cjs",
    "prepare": "pnpm run build"
  },
  "author": "Future AGI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_framework_attachments"
  },
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@traceai/fi-core": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "README.md",
    "!**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  }
}
