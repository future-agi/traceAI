{
  "name": "@traceai/pgvector",
  "version": "0.1.1",
  "description": "TraceAI instrumentation for pgvector (PostgreSQL vector extension)",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "jest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "traceai",
    "opentelemetry",
    "instrumentation",
    "pgvector",
    "postgresql",
    "vector-database",
    "futureagi",
    "observability",
    "tracing",
    "llm"
  ],
  "author": "Future AGI",
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/instrumentation": "^0.46.0",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.202.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "pg": "^8.23.1",
    "pg-floor": "npm:pg@8.0.0",
    "pgvector": "^0.1.8",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "pg": ">=8.0.0",
    "pgvector": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pgvector": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://docs.futureagi.com/docs/tracing",
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_pgvector"
  }
}
