{
  "name": "@traceai/vercel",
  "version": "0.1.4",
  "description": "OpenTelemetry instrumentation for Vercel",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "esnext": "./dist/esnext/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "prepare": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_vercel"
  },
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  },
  "homepage": "https://docs.futureagi.com/docs/integrations/traceai/vercel",
  "dependencies": {
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@traceai/fi-semantic-conventions": "workspace:^",
    "@opentelemetry/instrumentation": "^0.202.0",
    "@traceai/fi-core": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.7.0 <2.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "ai": "6.0.320",
    "@opentelemetry/api": ">=1.7.0 <2.0.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ai-v5": "npm:ai@5.0.283",
    "ai-v7": "npm:ai@7.0.158",
    "zod": "^4.3.6",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "rimraf": "6.1.2",
    "tsc-alias": "1.8.16"
  },
  "keywords": [
    "opentelemetry",
    "instrumentation",
    "typescript",
    "openai",
    "vercel",
    "traceai",
    "futureagi",
    "observability",
    "tracing",
    "llm"
  ],
  "author": "Future AGI",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
