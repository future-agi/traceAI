{
  "name": "@traceai/n8n",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for n8n workflow execution",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/esm/package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json && tsc -p tsconfig.esm.json && node scripts/esm-package.cjs",
    "test": "node --test test/*.test.cjs",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.cjs",
    "typecheck": "tsc --build tsconfig.json",
    "lint": "prettier --check src test scripts *.json *.md",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run lint"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/instrumentation": "^0.202.0",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "peerDependencies": {
    "n8n-core": ">=2.16.1 <3"
  },
  "peerDependenciesMeta": {
    "n8n-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@types/node": "^22.15.29",
    "n8n-core": "2.16.1",
    "n8n-workflow": "2.16.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.16"
  },
  "author": "Future AGI <no-reply@futureagi.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_n8n"
  },
  "publishConfig": {
    "access": "public"
  }
}
