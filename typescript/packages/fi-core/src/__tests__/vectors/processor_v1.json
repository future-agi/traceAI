{
  "contract": "futureagi.runtime.span_attributes.v1",
  "vectors": [
    {
      "name": "carrier stamps context agent and multiple skills",
      "carrier": {"v": 1, "attrs": {"fi.context.name": "support", "gen_ai.agent.name": "refund", "fi.skills.version_ids": ["11111111-1111-4111-8111-111111111111", "22222222-2222-4222-8222-222222222222"], "fi.skills.count": 2}, "reset_skills": false},
      "registry": {}, "explicit": {},
      "expected": {"fi.context.name": "support", "gen_ai.agent.name": "refund", "fi.skills.version_ids": ["11111111-1111-4111-8111-111111111111", "22222222-2222-4222-8222-222222222222"], "fi.skills.count": 2}
    },
    {
      "name": "explicit values and nested framework agent win",
      "carrier": {"v": 1, "attrs": {"gen_ai.agent.name": "parent", "fi.skills.count": 2}, "reset_skills": false},
      "registry": {}, "explicit": {"gen_ai.agent.name": "child", "fi.skills.count": 0},
      "expected": {"gen_ai.agent.name": "child", "fi.skills.count": 0}
    },
    {
      "name": "carrier reset never merges automatic registry",
      "carrier": {"v": 1, "attrs": {"fi.context.name": "child"}, "reset_skills": true},
      "registry": {"fi.context.name": "parent", "fi.skills.version_ids": ["11111111-1111-4111-8111-111111111111"]},
      "explicit": {}, "expected": {"fi.context.name": "child"}
    },
    {
      "name": "plain carrier is also authoritative",
      "carrier": {"v": 1, "attrs": {"gen_ai.agent.name": "child"}, "reset_skills": false},
      "registry": {"fi.skills.count": 1}, "explicit": {},
      "expected": {"gen_ai.agent.name": "child"}
    },
    {
      "name": "absent carrier falls back to trace registry",
      "carrier": null, "registry": {"fi.skills.count": 1, "fi.skills.refs": ["refund@v3"]},
      "explicit": {}, "expected": {"fi.skills.count": 1, "fi.skills.refs": ["refund@v3"]}
    },
    {
      "name": "drop nonallowlisted scalar identity and secrets",
      "carrier": {"v": 1, "attrs": {"fi.skill.version_id": "not-a-load", "credential": "never-export", "user.email": "never-export", "fi.skills.count": 1}, "reset_skills": false},
      "registry": {}, "explicit": {}, "expected": {"fi.skills.count": 1}
    },
    {
      "name": "unknown carrier version fails closed without registry fallback",
      "carrier": {"v": 2, "attrs": {"fi.skills.count": 1}, "reset_skills": false},
      "registry": {"fi.skills.count": 2}, "explicit": {}, "expected": {}
    },
    {
      "name": "empty carrier suppresses stale trace registry",
      "carrier": {"v": 1, "attrs": {}, "reset_skills": true},
      "registry": {"fi.skills.count": 3}, "explicit": {}, "expected": {}
    }
  ]
}
