{
  "extends": "../../tsconfig.base.esm.json",
  "compilerOptions": {
    "outDir": "dist/esm",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/esm/tsconfig.esm.tsbuildinfo",
    "baseUrl": "./src",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ]
}
