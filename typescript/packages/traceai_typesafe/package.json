{
  "name": "@traceai/typesafe",
  "version": "0.1.0",
  "description": "TraceAI instrumentation for the TypeSafe AI SDK",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json && echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "jest --config jest.config.js",
    "clean": "rimraf dist"
  },
  "keywords": [
    "traceai",
    "opentelemetry",
    "instrumentation",
    "typesafe",
    "evaluator",
    "observability",
    "tracing",
    "futureagi"
  ],
  "author": "Future AGI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_typesafe"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.29.0",
    "@opentelemetry/instrumentation": "^0.56.0",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^1.29.0",
    "@opentelemetry/sdk-trace-node": "^1.29.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typesafe-ai/sdk": "0.7.0",
    "@typesafe-ai/sdk-floor": "npm:@typesafe-ai/sdk@0.5.7",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": ">=0.5.7 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@typesafe-ai/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://docs.futureagi.com/docs/tracing",
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  }
}
