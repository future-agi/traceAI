{
  "name": "@traceai/cursor-sdk",
  "version": "0.1.0",
  "description": "OpenTelemetry tracing for the Cursor TypeScript SDK (@cursor/sdk) agent runs",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "esnext": "./dist/esnext/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "jest",
    "typecheck:contract": "tsc --noEmit -p contract/tsconfig.json",
    "test:contract": "pnpm run build && pnpm run typecheck:contract && node contract/auto_instrument.cjs && node contract/real_sdk_error.mjs",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "instrumentation",
    "cursor",
    "cursor-sdk",
    "coding-agent",
    "agents",
    "llm",
    "observability"
  ],
  "author": "Future AGI <no-reply@futureagi.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_cursor_sdk"
  },
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  },
  "homepage": "https://github.com/future-agi/traceAI/tree/main/typescript/packages/traceai_cursor_sdk#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.202.0",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "devDependencies": {
    "@cursor/sdk": "1.0.38",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@cursor/sdk": ">=1.0.0 <2"
  },
  "peerDependenciesMeta": {
    "@cursor/sdk": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  }
}
