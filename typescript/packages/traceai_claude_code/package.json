{
  "name": "@traceai/claude-code",
  "version": "0.1.0",
  "description": "One-command Claude Code transcript tracing for Future AGI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc -p tsconfig.json && esbuild src/hook.ts --bundle --platform=node --format=cjs --main-fields=module,main --outfile=dist/hook.cjs",
    "test": "node --test test/*.test.cjs",
    "test:binary": "node test/binary.cjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@traceai/agent-core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.29",
    "esbuild": "0.25.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_claude_code"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
