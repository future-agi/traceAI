{
  "name": "@traceai/voltagent",
  "version": "0.1.0",
  "description": "Future AGI span processor for VoltAgent: maps VoltAgent's native OpenTelemetry spans onto Future AGI / GenAI conventions",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "esnext": "./dist/esnext/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && pnpm run postbuild",
    "postbuild": "echo '{\"type\": \"module\"}' > ./dist/esm/package.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "prepare": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_voltagent"
  },
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  },
  "homepage": "https://github.com/future-agi/traceAI/tree/main/typescript/packages/traceai_voltagent#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "peerDependencies": {
    "@voltagent/core": "^2.11.0"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "^4.0.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/resources": "^2.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.29",
    "@voltagent/core": "2.11.0",
    "@voltagent/logger": "2.0.2",
    "ai": "6.0.97",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.4",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "zod": "4.3.6"
  },
  "keywords": [
    "opentelemetry",
    "instrumentation",
    "typescript",
    "voltagent",
    "futureagi"
  ],
  "license": "Apache-2.0",
  "author": "Future AGI <no-reply@futureagi.com>",
  "publishConfig": {
    "access": "public"
  }
}
