{
  "name": "@traceai/fi-instrumentation-pipecat",
  "version": "0.1.1",
  "description": "OpenTelemetry client lifecycle and operation tracing for Pipecat JavaScript",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js",
      "require": "./dist/src/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "build:watch": "tsc -w",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "node --test test/*.test.cjs",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "instrumentation",
    "pipecat",
    "client",
    "real-time",
    "observability",
    "traceai",
    "futureagi"
  ],
  "author": "Future AGI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_pipecat"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/instrumentation": "^0.46.0",
    "@traceai/fi-core": "workspace:^",
    "@traceai/fi-semantic-conventions": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.57.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/sdk-trace-web": "1.30.1",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/otlp-transformer": "0.57.2",
    "@pipecat-ai/client-js": "1.16.0",
    "@types/node": "^20.10.0",
    "esbuild": "0.25.12",
    "pipecat-floor": "npm:@pipecat-ai/client-js@0.3.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@pipecat-ai/client-js": "^0.3.0 || ^1.16.0"
  },
  "peerDependenciesMeta": {
    "@pipecat-ai/client-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/future-agi/traceAI/tree/dev/typescript/packages/traceai_pipecat#readme",
  "bugs": {
    "url": "https://github.com/future-agi/traceAI/issues"
  }
}
