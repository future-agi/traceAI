{
  "name": "@traceai/agents",
  "version": "0.1.0",
  "description": "Unified setup and diagnosis for Future AGI coding-agent integrations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fi-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.cjs",
    "prepare": "pnpm run build"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@traceai/agent-core": "workspace:^",
    "@traceai/codex-plugin": "workspace:^",
    "@traceai/antigravity-plugin": "workspace:^",
    "jsonc-parser": "3.3.1",
    "@traceai/copilot": "workspace:^",
    "@traceai/hermes-agent": "workspace:^",
    "@traceai/openclaw": "workspace:^",
    "@traceai/grok-plugin": "workspace:^",
    "@traceai/muse-plugin": "workspace:^",
    "@traceai/gemini-cli": "workspace:^",
    "@traceai/kiro-plugin": "workspace:^",
    "@traceai/augment-plugin": "workspace:^",
    "@traceai/devin-cascade": "workspace:^",
    "@traceai/claude-code": "workspace:^",
    "@traceai/goose": "workspace:^",
    "@traceai/pi-plugin": "workspace:^",
    "@traceai/oh-my-pi-plugin": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.29",
    "@traceai/cursor-plugin": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_agents"
  },
  "license": "Apache-2.0",
  "author": "Future AGI",
  "publishConfig": {
    "access": "public"
  }
