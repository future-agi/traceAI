{
  "name": "@traceai/auto",
  "version": "0.1.0",
  "description": "Fail-open, zero-code AI auto-instrumentation for Node.js",
  "main": "./dist/src/index.js",
  "module": "./dist/esm/index.js",
  "esnext": "./dist/esnext/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/src/index.js"
    },
    "./register": {
      "import": "./dist/esm/register.js",
      "require": "./dist/src/register.js"
    },
    "./esbuild": {
      "types": "./dist/src/bundlers/esbuild.d.ts",
      "import": "./dist/esm/bundlers/esbuild.js",
      "require": "./dist/src/bundlers/esbuild.js"
    },
    "./vite": {
      "types": "./dist/src/bundlers/vite.d.ts",
      "import": "./dist/esm/bundlers/vite.js",
      "require": "./dist/src/bundlers/vite.js"
    },
    "./rollup": {
      "types": "./dist/src/bundlers/rollup.d.ts",
      "import": "./dist/esm/bundlers/rollup.js",
      "require": "./dist/src/bundlers/rollup.js"
    },
    "./webpack": {
      "types": "./dist/src/bundlers/webpack.d.ts",
      "import": "./dist/esm/bundlers/webpack.js",
      "require": "./dist/src/bundlers/webpack.js"
    },
    "./next": {
      "types": "./dist/src/bundlers/next.d.ts",
      "import": "./dist/esm/bundlers/next.js",
      "require": "./dist/src/bundlers/next.js"
    },
    "./edge": {
      "types": "./dist/src/edge.d.ts",
      "import": "./dist/edge/index.mjs",
      "require": "./dist/src/edge.js"
    },
    "./preload.cjs": "./dist/agent/preload.cjs"
  },
  "bin": {
    "traceai-auto": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.json tsconfig.esm.json tsconfig.esnext.json && tsc-alias -p tsconfig.esm.json && node scripts/postbuild.cjs && node scripts/build-agent.cjs",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "build:agent": "node scripts/build-agent.cjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@traceai/fi-core": "workspace:^",
    "@traceai/openai": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/instrumentation": "^0.202.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "otel-sdk-trace-base-legacy": "npm:@opentelemetry/sdk-trace-base@1.30.1",
    "@opentelemetry/instrumentation-http": "^0.202.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.29",
    "@types/semver": "^7.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.8.3",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "openai": "^4.52.7",
    "esbuild": "0.27.2",
    "rollup": "4.56.0",
    "vite": "7.3.1",
    "webpack": "5.104.1",
    "tsx": "4.21.0",
    "@anthropic-ai/sdk": "0.27.3",
    "@traceai/genkit": "workspace:^",
    "genkit": "1.42.0",
    "ai": "6.0.320",
    "@mastra/core": "1.37.1",
    "@openai/agents": "0.21.0",
    "zod": "4.3.6",
    "@cursor/sdk": "1.0.38",
    "undici": "7.30.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_auto"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
