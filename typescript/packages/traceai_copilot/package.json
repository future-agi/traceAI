{
  "name": "@traceai/copilot",
  "version": "0.1.0",
  "description": "Daemon-free native GitHub Copilot CLI tracing launcher for Future AGI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vscode": {
      "types": "./dist/vscode/index.d.ts",
      "default": "./dist/vscode/index.js"
    }
  },
  "typesVersions": { "*": { "vscode": ["dist/vscode/index.d.ts"] } },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.cjs",
    "test:binary": "node test/real-binary.cjs",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@traceai/agent-core": "workspace:^",
    "@traceai/vscode-extension": "workspace:^",
    "jsonc-parser": "3.3.1",
    "@traceai/fi-semantic-conventions": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.29"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_copilot"
  },
  "license": "Apache-2.0",
  "author": "Future AGI",
  "publishConfig": {
    "access": "public"
  }
}
