{
  "name": "@traceai/flue",
  "version": "0.1.0",
  "description": "Future AGI configuration and lifecycle adapter for Flue's native OpenTelemetry tracing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:lifecycle": "node --test test/lifecycle.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "peerDependencies": {
    "@flue/opentelemetry": ">=2.2.2 <2.4.0",
    "@flue/runtime": ">=2.2.2 <2.4.0"
  },
  "devDependencies": {
    "@flue/cli": "2.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@flue/opentelemetry": "2.3.0",
    "@flue/runtime": "2.3.0",
    "@flue/vite": "2.3.0",
    "protobufjs": "7.5.4",
    "@types/node": "22.15.29",
    "hono": "4.13.13",
    "typescript": "5.8.3",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_flue"
  },
  "bugs": { "url": "https://github.com/future-agi/traceAI/issues" },
  "homepage": "https://docs.futureagi.com/docs/integrations/frameworks/flue",
  "license": "Apache-2.0",
  "author": "Future AGI",
  "keywords": ["flue", "opentelemetry", "futureagi", "traceai", "tracing"],
  "publishConfig": { "access": "public" }
}
