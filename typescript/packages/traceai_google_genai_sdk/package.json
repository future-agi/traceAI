    "test": "node --test test/compat.test.cjs test/advanced.test.cjs test/edges.test.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.1",
    "@traceai/fi-core": "^1.1.0",
    "@traceai/fi-semantic-conventions": "^1.0.0"
  },
  "peerDependencies": {
    "@google/genai": ">=1.33.0 <3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.15.29",
    "@google/genai": "2.32.0",
    "@opentelemetry/sdk-trace-node": "^2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/future-agi/traceAI.git",
    "directory": "typescript/packages/traceai_google_genai_sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
