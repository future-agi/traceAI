{
  "name": "@traceai/google-genai-sdk",
  "version": "0.1.0",
  "description": "Per-client OpenTelemetry instrumentation for the modern @google/genai Node.js SDK",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
